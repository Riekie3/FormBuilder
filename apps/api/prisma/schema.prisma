// Smart Form Builder schema — Phase 1 (core), Phase 2 (roles/departments),
// Phase 3 (approval workflow). Remaining phases sketched at the bottom as
// comments so the eventual migration path is clear without shipping
// half-built models now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FieldType {
  TEXT
  PARAGRAPH
  EMAIL
  NUMBER
  PHONE
  DATE
  DROPDOWN
  RADIO
  CHECKBOX
  ADDRESS
  RATING
  SIGNATURE
  DIVIDER
  HEADING
  HTML_BLOCK
  HIDDEN
  RICH_TEXT
  CALCULATION
  PAGE_BREAK
  MATRIX
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

// Only meaningful when the response's form has requiresApproval = true;
// forms without approval leave Response.status null (unchanged Phase 1
// behavior — a submission is immediately final).
enum ResponseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  // Bypasses all permission checks and can manage departments/roles/members.
  // A full admin panel (users, billing, logs) arrives in a later phase; this
  // flag is the minimal seed that phase builds on.
  isSuperAdmin  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  forms         Form[]
  refreshTokens RefreshToken[]
  memberships   Membership[]
  decisions     Response[]     @relation("ResponseDecidedBy")
}

model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  forms       Form[]
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  canView     Boolean      @default(true)
  canCreate   Boolean      @default(false)
  canEdit     Boolean      @default(false)
  canDelete   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  // Forms that use this role as their single approval step (Phase 3).
  approvesForForms Form[]  @relation("FormApproverRole")
}

// A user's role within one department. A user can hold several of these
// (multiple departments, and/or multiple roles within one department).
model Membership {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId, roleId])
  @@index([userId])
  @@index([departmentId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Form {
  id          String      @id @default(cuid())
  title       String
  description String?
  slug        String      @unique
  status      FormStatus  @default(DRAFT)
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Null = private form, visible only to its owner (and super admins) —
  // the original Phase 1 behavior. Set = department-wide access applies,
  // per each member's role permissions.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Opt-in, single-level approval (Phase 3). Only settable when departmentId
  // is set — approval needs someone other than the submitter to review, and
  // approverRoleId is resolved against Memberships in this form's department.
  requiresApproval Boolean  @default(false)
  approverRoleId   String?
  approverRole     Role?    @relation("FormApproverRole", fields: [approverRoleId], references: [id], onDelete: SetNull)
  // Free-text tag/reference code for the owner's own organization (SOW 2.7
  // "product code naming") — never shown to public form visitors.
  productCode String?
  fields      Field[]
  responses   Response[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId])
  @@index([departmentId])
  @@index([approverRoleId])
}

model Field {
  id        String    @id @default(cuid())
  formId    String
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  type      FieldType
  label     String
  required  Boolean   @default(false)
  order     Int
  config    Json      @default("{}")
  answers   Answer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([formId])
}

model Response {
  id          String         @id @default(cuid())
  formId      String
  form        Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     Answer[]
  submittedAt DateTime       @default(now())
  ipHash      String?
  // Null unless the form has requiresApproval — see ResponseStatus above.
  status           ResponseStatus?
  decidedByUserId  String?
  decidedBy        User?           @relation("ResponseDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decisionComment  String?

  @@index([formId])
  @@index([status])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  fieldId    String
  field      Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value      String

  @@index([responseId])
  @@index([fieldId])
}

model Template {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    String
  fields      Json
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Later phases (sketch only — not migrated):
//
// Phase 3 ships single-level approval directly on Form/Response (see above).
// A future multi-level pass would replace requiresApproval/approverRoleId
// with something like:
//   model ApprovalFlow  { id, formId, sequential }
//   model ApprovalStep  { id, flowId, order, approverRoleId }
//   model ApprovalDecision { id, responseId, stepId, decidedByUserId, status, comment }
//
// Multi-page forms (Phase 4 continuation) did NOT need a Page model — a
// PAGE_BREAK field (see FieldType above) already marks where a new page
// starts, reusing the existing field-ordering/config machinery instead of
// introducing a second way to represent form structure.
// model Attachment    { id, answerId, url, mimeType, size }         // Phase 6 — file/image upload fields
// model Payment       { id, responseId, provider, amount, status }  // Phase 6 — payment field
// model Notification  { id, userId, type, payload, readAt }         // in-app notifications
// model ApiKey        { id, userId, keyHash, label, lastUsedAt }    // Phase 8 — public API access
// ---------------------------------------------------------------------------
