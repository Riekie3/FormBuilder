NODE_ENV=development
PORT=4000

# When using docker-compose, this matches the "postgres" service.
# When using `npm run db:local` (no-Docker fallback), use:
# postgresql://postgres:postgres@localhost:54329/smart_form_builder
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_form_builder

# Generate real secrets for anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

WEB_ORIGIN=http://localhost:3000
